# CONTOH saja. JANGAN isi key asli di file ini (file ini boleh masuk GitHub).
#
# Cara pakai di Streamlit Community Cloud:
#   Buka aplikasimu > Manage app > Settings > Secrets, lalu tempel isi file ini
#   dengan key asli kamu (semua nilai pakai tanda kutip).
#
# Cara pakai di laptop (opsional, karena file .env juga bisa):
#   salin file ini menjadi ".streamlit/secrets.toml" lalu isi key asli.
#   File secrets.toml sudah masuk .gitignore, jadi tidak ikut ke GitHub.

OPENAI_API_KEY = "isi_dengan_key_kamu"
# Isi baris di bawah HANYA kalau key-nya dari OpenRouter (diawali sk-or-). Kalau key OpenAI asli, hapus barisnya.
OPENAI_BASE_URL = "https://openrouter.ai/api/v1"

QDRANT_URL = "isi_dengan_url_cluster_qdrant_kamu"
QDRANT_API_KEY = "isi_dengan_api_key_qdrant_kamu"

LANGFUSE_PUBLIC_KEY = "isi_dengan_public_key_langfuse"
LANGFUSE_SECRET_KEY = "isi_dengan_secret_key_langfuse"
LANGFUSE_HOST = "https://us.cloud.langfuse.com"
